# Server Environment Variables Template
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/spraysystem
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Default Admin Seed Credentials (Change on production)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@spraysystem.com
ADMIN_PASSWORD=change_this_password_in_production
